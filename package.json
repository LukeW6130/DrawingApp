{
  "name": "nocturne-notes",
  "version": "1.1.0",
  "description": "Offline infinite-canvas ink and study notes for Windows",
  "author": "DrawingApp contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/core.test.js",
    "test:ui": "node scripts/smoke.mjs",
    "test:browser": "node scripts/regressions.mjs",
    "dist": "npm run build && electron-builder --win portable --x64",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir",
    "format": "prettier --write src electron tests scripts *.js *.json *.html"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "vite": "^7.1.12"
  },
  "build": {
    "appId": "io.drawingapp.nocturne",
    "productName": "Nocturne Notes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Nocturne-Notes-${version}-Windows-x64.exe"
    }
  }
}
